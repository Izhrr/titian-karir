		dataType: double
		summarizeBy: none
		sourceColumn: tpt_2025
		lineageTag: fc1ec08a-c7b0-5f2c-8a53-4a4a6a1e172b

		annotation SummarizationSetBy = User

	column penganggur_2025
		dataType: double
