table TPTJenjang
	lineageTag: 1eac8489-bd57-5790-9ff1-4881ddad1b64

	measure TPT = SUM ( TPTJenjang[tpt_2025] )
		formatString: 0.00
		lineageTag: 8769a525-565f-5993-8c84-dddb681cde34

	measure 'Warna Jenjang' = VAR j = SELECTEDVALUE ( TPTJenjang[jenjang] ) RETURN SWITCH ( TRUE (), j = "SMK", "#1A64DB", j = [Cmp], "#6F7F99", "#CBD4E1" )
		lineageTag: 0348d20e-c03e-50bd-ba68-b64a81667ef2

	measure 'Insight TPT' =
			VAR s = CALCULATE ( SUM ( TPTJenjang[tpt_2025] ), TPTJenjang[jenjang] = "SMK" )
			VAR c = [Cmp]
			VAR b = CALCULATE ( SUM ( TPTJenjang[tpt_2025] ), TPTJenjang[jenjang] = c )
			RETURN "Insight: TPT SMK " & FORMAT ( s / b, "0.00", "id-ID" ) & "× " & c & "."
		lineageTag: e5a5f313-5509-581a-8e7a-37c2fbfa3926

	measure 'Potensi Nasional' =
			VAR ak = CALCULATE ( SUM ( TPTJenjang[ak_2025] ), TPTJenjang[jenjang] = "SMK" )
			VAR s = CALCULATE ( SUM ( TPTJenjang[tpt_2025] ), TPTJenjang[jenjang] = "SMK" )
			VAR c = [Cmp]
			VAR b = CALCULATE ( SUM ( TPTJenjang[tpt_2025] ), TPTJenjang[jenjang] = c )
			RETURN FORMAT ( MAX ( 0, ak * ( s - b ) / 100 ), "#,0", "id-ID" )
		lineageTag: b4e37cec-5806-5ea1-af73-dee8a865c429

	measure 'Potensi Nasional Sub' =
			VAR c = [Cmp]
			VAR b = CALCULATE ( SUM ( TPTJenjang[tpt_2025] ), TPTJenjang[jenjang] = c )
			RETURN "bila TPT SMK turun ke " & c & " (" & FORMAT ( b, "0.00", "id-ID" ) & "%)"
		lineageTag: 8c7bb5c5-04a6-5eb2-9e65-9b30656cd6d9

	column jenjang
		dataType: string
		summarizeBy: none
		sourceColumn: jenjang
		lineageTag: 4229d00e-2982-5137-b3b4-b6f92545111b

		annotation SummarizationSetBy = User

