table KabProfil
	lineageTag: c2756744-7506-51b9-a2fc-802a5e2f2093

	measure 'Sumbu PC1' = SUM ( KabProfil[pc1] )
		formatString: 0.00
		lineageTag: b0c4ca3d-3108-5803-96f5-8676a47c6ca2

	measure 'Sumbu PC2' = SUM ( KabProfil[pc2] )
		formatString: 0.00
		lineageTag: fb597935-fef3-5a4d-ba51-8fc1fc58a4d4

	measure 'TPT SMK Kab' = SUM ( KabProfil[tpt_smk] )
		formatString: 0.0
		lineageTag: bf52837b-5550-518e-a42d-1dabf323e06d

	measure 'Penganggur SMK Kab' = SUM ( KabProfil[penganggur_smk] )
		formatString: #,0
		lineageTag: 537b03ad-f436-5b3e-a132-db83fc0a5d69

	measure 'Potensi Terserap' = SUM ( KabProfil[potensi_terserap] )
		formatString: #,0
		lineageTag: 0a8fb825-ed5f-5c54-8f38-f1b22cef8012

	measure 'Potensi Jateng' = FORMAT ( SUM ( KabProfil[potensi_terserap] ), "#,0", "id-ID" )
		lineageTag: 479b0126-f5fc-5fc5-8568-084e1c6833a6

	measure 'Selisih Gender' =
			VAR t = ADDCOLUMNS ( VALUES ( DimKab[kab] ), "d", ABS ( CALCULATE ( SUM ( KabProfil[tpt_smk_L] ) - SUM ( KabProfil[tpt_smk_P] ) ) ) )
			RETURN FORMAT ( MAXX ( TOPN ( 1, t, [d], DESC ), [d] ), "0.0", "id-ID" ) & " poin"
		lineageTag: 2cf5e546-7eb9-557b-9218-d7c5a28b9567

	measure 'Selisih Gender Sub' =
			VAR t = ADDCOLUMNS ( VALUES ( DimKab[kab] ), "d", ABS ( CALCULATE ( SUM ( KabProfil[tpt_smk_L] ) - SUM ( KabProfil[tpt_smk_P] ) ) ),
			    "l", CALCULATE ( SUM ( KabProfil[tpt_smk_L] ) ), "p", CALCULATE ( SUM ( KabProfil[tpt_smk_P] ) ) )
			VAR r = TOPN ( 1, t, [d], DESC )
			RETURN MAXX ( r, DimKab[kab] ) & ": L " & FORMAT ( MAXX ( r, [l] ), "0.0", "id-ID" ) & "% vs P " & FORMAT ( MAXX ( r, [p] ), "0.0", "id-ID" ) & "%"
		lineageTag: 68ffc8b8-a550-571c-a2e1-3058e94c8acb

	measure 'Insight Aksi' =
			VAR t = ADDCOLUMNS ( VALUES ( DimKab[kab] ), "p", CALCULATE ( SUM ( KabProfil[potensi_terserap] ) ) )
			VAR tot = SUMX ( t, [p] )
			VAR top3 = SUMX ( TOPN ( 3, t, [p], DESC ), [p] )
			RETURN "Insight: 3 kab teratas = " & FORMAT ( DIVIDE ( top3, tot ), "0%", "id-ID" ) & " dari potensi " & FORMAT ( tot, "#,0", "id-ID" ) & " lulusan."
		lineageTag: bdfc4524-9c15-58e4-acad-c2612897d41b

