table Pekerjaan
	lineageTag: 890ea3af-db8e-518f-972a-cac05516b434

	measure 'Porsi SMK' = CALCULATE ( SUM ( Pekerjaan[porsi] ), Pekerjaan[jenjang] = "SMK" )
		formatString: 0.0
		lineageTag: 16a651a1-4d18-523d-8bf8-73954080649d

	measure 'Porsi Pembanding' = VAR c = [Cmp] RETURN CALCULATE ( SUM ( Pekerjaan[porsi] ), Pekerjaan[jenjang] = c )
		formatString: 0.0
		lineageTag: c3a2a978-c6c2-5b88-a907-5f7e928e7d4c

	measure 'Insight Pekerjaan' =
			VAR a = CALCULATE ( SUM ( Pekerjaan[porsi] ), Pekerjaan[jenjang] = "SMK", Pekerjaan[pekerjaan] = "Operator, kasar" )
			VAR c = [Cmp]
			VAR b = CALCULATE ( SUM ( Pekerjaan[porsi] ), Pekerjaan[jenjang] = c, Pekerjaan[pekerjaan] = "Operator, kasar" )
			RETURN FORMAT ( a, "0.0", "id-ID" ) & "% lulusan SMK jadi operator atau pekerja kasar (" & c & " " & FORMAT ( b, "0.0", "id-ID" ) & "%)."
		lineageTag: a36116eb-6a10-5f0c-bd4a-0d4230597fd5

