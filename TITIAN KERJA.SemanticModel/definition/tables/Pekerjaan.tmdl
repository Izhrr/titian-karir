	partition Pekerjaan = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [jenjang = _t, pekerjaan = _t, pekerja = _t, porsi = _t]),
				    Typed = Table.TransformColumnTypes(Source, {{"jenjang", type text}, {"pekerjaan", type text}, {"pekerja", type number}, {"porsi", type number}}, "en-US")
