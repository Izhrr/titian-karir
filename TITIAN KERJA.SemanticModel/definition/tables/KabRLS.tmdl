	partition KabRLS = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [label = _t, kab = _t, provinsi = _t, rls = _t, pengeluaran = _t, p0 = _t, uhh = _t, tpt = _t]),
				    Typed = Table.TransformColumnTypes(Source, {{"label", type text}, {"kab", type text}, {"provinsi", type text}, {"rls", type number}, {"pengeluaran", type number}, {"p0", type number}, {"uhh", type number}, {"tpt", type number}}, "en-US")
				in
