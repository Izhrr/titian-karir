table KabRLS
	lineageTag: c5663d73-8f78-59a1-aaba-567e558fb49c

	measure 'RLS Kab' = SUM ( KabRLS[rls] )
		formatString: 0.0
		lineageTag: 25e3d2b6-69ed-5522-a3df-b8d5769ea99b

	measure 'Nilai Indikator' =
			SWITCH ( SELECTEDVALUE ( Indikator[kode], "tpt" ), "tpt", SUM ( KabRLS[tpt] ), "pengeluaran", SUM ( KabRLS[pengeluaran] ) / 1000,
			    "p0", SUM ( KabRLS[p0] ), "uhh", SUM ( KabRLS[uhh] ) )
		formatString: 0.0
		lineageTag: ed48393b-80c2-5a8a-bd8d-3ae7081e70cc

	measure 'Warna Kab' = IF ( NOT ISFILTERED ( ProvSorot[provinsi] ) || SELECTEDVALUE ( KabRLS[provinsi] ) IN VALUES ( ProvSorot[provinsi] ), "#1A64DB", "#C5CEDB" )
		lineageTag: 17cb2687-8bcb-56c8-a663-c8f74b883a7d

	measure 'Efek Teks' =
			VAR k = SELECTEDVALUE ( Indikator[kode], "tpt" )
			VAR n = SWITCH ( k, "tpt", "TPT", "pengeluaran", "Pengeluaran per kapita", "p0", "Kemiskinan", "uhh", "Umur harapan hidup" )
			VAR e = CALCULATE ( SUM ( Efek[efek_per_tahun_rls] ), Efek[indikator] = n )
			VAR u = SWITCH ( k, "pengeluaran", "%", "uhh", " tahun", " poin" )
			RETURN "+1 tahun sekolah: " & IF ( e > 0, "+", "" ) & FORMAT ( e, IF ( k = "pengeluaran", "0.0", "0.00" ), "id-ID" ) & u
		lineageTag: 14fa1fe5-5ec4-508e-81c6-8cec8101202c

	measure 'Insight Sekolah' =
			VAR k = SELECTEDVALUE ( Indikator[kode], "tpt" )
			VAR t = FILTER ( ALL ( KabRLS ), KabRLS[provinsi] IN VALUES ( ProvSorot[provinsi] ) )
			VAR hi = TOPN ( 1, t, KabRLS[rls], DESC )
			VAR lo = TOPN ( 1, t, KabRLS[rls], ASC )
			VAR v = ( SWITCH ( k, "tpt", MAXX ( hi, KabRLS[tpt] ), "pengeluaran", MAXX ( hi, KabRLS[pengeluaran] ) / 1000, "p0", MAXX ( hi, KabRLS[p0] ), MAXX ( hi, KabRLS[uhh] ) ) )
			VAR w = ( SWITCH ( k, "tpt", MAXX ( lo, KabRLS[tpt] ), "pengeluaran", MAXX ( lo, KabRLS[pengeluaran] ) / 1000, "p0", MAXX ( lo, KabRLS[p0] ), MAXX ( lo, KabRLS[uhh] ) ) )
			VAR u = SWITCH ( k, "pengeluaran", " jt", "uhh", " thn", "%" )
			RETURN IF ( ISFILTERED ( ProvSorot[provinsi] ) && COUNTROWS ( VALUES ( ProvSorot[provinsi] ) ) <= 3,
			    "Insight: " & MAXX ( hi, KabRLS[kab] ) & " (sekolah " & FORMAT ( MAXX ( hi, KabRLS[rls] ), "0.0", "id-ID" ) & " thn) " & FORMAT ( v, "0.00", "id-ID" ) & u
			        & ", " & MAXX ( lo, KabRLS[kab] ) & " (" & FORMAT ( MAXX ( lo, KabRLS[rls] ), "0.0", "id-ID" ) & " thn) " & FORMAT ( w, "0.00", "id-ID" ) & u & ".",
			    IF ( k = "tpt", "Insight: arahnya berbalik, daerah lebih terdidik justru punya TPT lebih tinggi.", "Insight: daerah yang sekolahnya lebih lama lebih sejahtera." ) )
		lineageTag: fed92958-1808-5e3b-b70a-b66c900735d2

