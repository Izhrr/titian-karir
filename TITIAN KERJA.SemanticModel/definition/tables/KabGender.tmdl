table KabGender
	lineageTag: 394191bd-f0c4-5bfd-84fc-974c30c1d753

	measure 'TPT Terpilih' = DIVIDE ( SUM ( KabGender[penganggur] ), SUM ( KabGender[ak] ) ) * 100
		formatString: 0.0
		lineageTag: c9a318c1-c08e-5f12-ae6e-e0010b1b1e4d

	measure 'TPT SMK Pilihan' = FORMAT ( DIVIDE ( CALCULATE ( SUM ( KabGender[penganggur] ), KabGender[jenjang] = "SMK" ), CALCULATE ( SUM ( KabGender[ak] ), KabGender[jenjang] = "SMK" ) ) * 100, "0.00", "id-ID" )
		lineageTag: 1f2e2e98-58a4-5d5c-a314-cdd72eaf5a6d

	measure 'TPT SMK Pilihan Sub' =
			VAR j = DIVIDE ( CALCULATE ( SUM ( KabGender[penganggur] ), KabGender[jenjang] = "SMK", ALL ( DimKab ) ), CALCULATE ( SUM ( KabGender[ak] ), KabGender[jenjang] = "SMK", ALL ( DimKab ) ) ) * 100
			RETURN "Jawa Tengah " & FORMAT ( j, "0.00", "id-ID" ) & "%, nasional 8,63%"
		lineageTag: b0898dbf-4540-5263-b1fe-20735b4af1a2

	measure 'Penganggur SMK Pilihan' = FORMAT ( CALCULATE ( SUM ( KabGender[penganggur] ), KabGender[jenjang] = "SMK" ), "#,0", "id-ID" )
		lineageTag: e917d617-8d50-500b-8f04-d17b75aaddf5

	measure 'Penganggur SMK Pilihan Sub' =
			VAR a = CALCULATE ( SUM ( KabGender[penganggur] ), KabGender[jenjang] = "SMK" )
			VAR t = CALCULATE ( SUM ( KabGender[penganggur] ), KabGender[jenjang] = "SMK", ALL ( DimKab ) )
			RETURN FORMAT ( DIVIDE ( a, t ), "0.0%", "id-ID" ) & " penganggur SMK Jawa Tengah"
		lineageTag: b8bdf39a-1f1d-5e7b-8e2a-d61878272039

	measure 'Warna Tipologi' = SWITCH ( SELECTEDVALUE ( DimKab[tipologi] ), "Lulusan Sulit Kerja", "#E03131", "Sentra Industri", "#1F6FEB", "Basis Pertanian", "#D9822B", "Perkotaan Terdidik", "#0CA678", "#CBD4E1" )
		lineageTag: 63a97999-ae35-5d92-bebe-a413e5145cf3

	measure 'Insight Ranking' =
			VAR t = ADDCOLUMNS ( VALUES ( DimKab[kab] ), "v", [TPT Terpilih] )
			VAR mx = MAXX ( t, [v] )
			VAR nm = MAXX ( FILTER ( t, [v] = mx ), DimKab[kab] )
			VAR p = CALCULATE ( [TPT Terpilih], ALL ( DimKab ) )
			VAR n = COUNTROWS ( FILTER ( t, [v] > p ) )
			RETURN nm & " tertinggi, " & FORMAT ( DIVIDE ( mx, p ), "0.0", "id-ID" ) & "x rata-rata Jawa Tengah; " & FORMAT ( n, "0" ) & " dari " & FORMAT ( COUNTROWS ( t ), "0" ) & " kab/kota di atas rata-rata."
		lineageTag: 0f5465e3-01ef-5720-ada6-edc294eaa5d4

