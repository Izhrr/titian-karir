		annotation SummarizationSetBy = User

	partition KabGender = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [kab_code = _t, jenjang = _t, jk = _t, ak = _t, penganggur = _t]),
				    Typed = Table.TransformColumnTypes(Source, {{"kab_code", Int64.Type}, {"jenjang", type text}, {"jk", type text}, {"ak", type number}, {"penganggur", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
