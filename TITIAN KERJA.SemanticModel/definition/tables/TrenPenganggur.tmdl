		sourceColumn: atas
		lineageTag: e41c86eb-7900-53cf-bf60-77ebb02e76dd

		annotation SummarizationSetBy = User

	partition TrenPenganggur = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [tahun = _t, jenjang = _t, jenis = _t, juta = _t, bawah = _t, atas = _t]),
				    Typed = Table.TransformColumnTypes(Source, {{"tahun", Int64.Type}, {"jenjang", type text}, {"jenis", type text}, {"juta", type number}, {"bawah", type number}, {"atas", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
