table TrenPenganggur
	lineageTag: a96ed3f0-79ee-5b11-8d80-d9c06930522c

	measure Cmp = SELECTEDVALUE ( Pembanding[jenjang], "SMA umum" )
		lineageTag: 13323fcf-acc1-5335-a185-91659206d690

	measure 'SMK Aktual' = CALCULATE ( SUM ( TrenPenganggur[juta] ), TrenPenganggur[jenjang] = "SMK", TrenPenganggur[jenis] = "Aktual" )
		formatString: 0.00
		lineageTag: b1f8e4f1-e943-5508-9ceb-881b0f4229b2

	measure 'SMK Proyeksi' = CALCULATE ( SUM ( TrenPenganggur[juta] ), TrenPenganggur[jenjang] = "SMK", TrenPenganggur[jenis] = "Proyeksi" )
		formatString: 0.00
		lineageTag: 0dc7043d-cc1d-54ce-bf24-077cf67dab99

	measure Pembanding = VAR c = IF ( [Cmp] = "SD ke bawah", "SD", [Cmp] ) RETURN CALCULATE ( SUM ( TrenPenganggur[juta] ), TrenPenganggur[jenjang] = c )
		formatString: 0.00
		lineageTag: 420fb0ac-810a-5bc2-80f9-24c9737ba6f8

	measure 'Insight Tren' =
			VAR y0 = CALCULATE ( MIN ( TrenPenganggur[tahun] ), ALLSELECTED ( TrenPenganggur ) )
			VAR y1 = MIN ( CALCULATE ( MAX ( TrenPenganggur[tahun] ), ALLSELECTED ( TrenPenganggur ) ), 2025 )
			VAR c = IF ( [Cmp] = "SD ke bawah", "SD", [Cmp] )
			VAR a0 = CALCULATE ( SUM ( TrenPenganggur[juta] ), ALL ( TrenPenganggur ), TrenPenganggur[tahun] = y0, TrenPenganggur[jenjang] = "SMK" )
			VAR a1 = CALCULATE ( SUM ( TrenPenganggur[juta] ), ALL ( TrenPenganggur ), TrenPenganggur[tahun] = y1, TrenPenganggur[jenjang] = "SMK" )
			VAR b0 = CALCULATE ( SUM ( TrenPenganggur[juta] ), ALL ( TrenPenganggur ), TrenPenganggur[tahun] = y0, TrenPenganggur[jenjang] = c )
			VAR b1 = CALCULATE ( SUM ( TrenPenganggur[juta] ), ALL ( TrenPenganggur ), TrenPenganggur[tahun] = y1, TrenPenganggur[jenjang] = c )
			RETURN "Insight: " & y0 & "-" & y1 & " penganggur SMK " & IF ( a1 >= a0, "naik ", "turun " ) & FORMAT ( ABS ( a1 / a0 - 1 ), "0.0%", "id-ID" )
			    & ", " & [Cmp] & " " & IF ( b1 >= b0, "naik ", "turun " ) & FORMAT ( ABS ( b1 / b0 - 1 ), "0.0%", "id-ID" ) & "."
		lineageTag: ca925986-920f-5687-af2e-da2a36d33ab9

	column tahun
		dataType: int64
		summarizeBy: none
		sourceColumn: tahun
		lineageTag: d72279e0-dbe3-537b-b0df-04a801fd79c0

		annotation SummarizationSetBy = User

